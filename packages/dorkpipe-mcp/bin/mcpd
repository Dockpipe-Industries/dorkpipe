#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
DOCKPIPE_BIN="${DOCKPIPE_BIN:-dockpipe}"
if ! command -v "$DOCKPIPE_BIN" >/dev/null 2>&1; then
  echo 'mcpd wrapper: select an installed DockPipe with DOCKPIPE_BIN.' >&2
  exit 1
fi
sdk_exports="$("$DOCKPIPE_BIN" sdk --workdir "$ROOT")"
eval "$sdk_exports"
TARGET="$(dockpipe_sdk path state tooling bin mcpd)"

mcpd_target_is_stale() {
  [[ -x "$TARGET" ]] || return 0
  if [[ -f "$ROOT/VERSION" && "$ROOT/VERSION" -nt "$TARGET" ]]; then
    return 0
  fi
  find "$ROOT/packages/dorkpipe-mcp" \
    \( -path '*/.git' -o -path '*/bin' -o -path '*/node_modules' -o -path '*/.dockpipe' \) -prune \
    -o -type f \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$TARGET" -print -quit \
    | grep -q .
}

if mcpd_target_is_stale; then
  "$DOCKPIPE_BIN" package build source --workdir "$ROOT" --only dorkpipe.mcp
fi

if [[ ! -x "$TARGET" ]]; then
  echo "mcpd wrapper: missing maintainer binary at $TARGET" >&2
  echo "Run: $DOCKPIPE_BIN package build source --workdir $ROOT --only dorkpipe.mcp" >&2
  exit 1
fi

exec "$TARGET" "$@"
